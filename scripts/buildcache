#!/bin/sh
scripts=${0%/*}
cache=${XDG_CACHE_HOME:-$HOME/.cache}/nanocode/build
source=$scripts/buildcache.rs
run() {
  case $1 in
    *rustc)
      for arg; do
        case $arg in
          /*) ;;
          *.rs) exec "$scripts/rustc-parallel-frontend" "$@" ;;
        esac
      done
      ;;
  esac
  exec "$@"
}
checksum=$(cksum < "$source") || run "$@"
helper=$cache/bin/buildcache-${checksum%% *}
[ -x "$helper" ] && exec "$helper" "$scripts" "$@"
[ -f "$helper.failed" ] && run "$@"
case $1 in
  *rustc|publish)
    compiler=$1
    [ "$1" = publish ] && compiler=rustc
    mkdir -p "$cache/bin" || run "$@"
    if [ -d "$helper.lock" ]; then
      { read -r builder < "$helper.lock/pid"; } 2>/dev/null
      kill -0 "${builder:-0}" 2>/dev/null || rm -rf "$helper.lock"
    fi
    if mkdir "$helper.lock" 2>/dev/null; then
      echo $$ > "$helper.lock/pid"
      (
        sh -c 'echo $PPID' > "$helper.lock/pid"
        if env -u CARGO_MAKEFLAGS -u MAKEFLAGS -u MFLAGS "$compiler" --edition 2024 -C opt-level=2 -o "$helper.$$" "$source"; then
          mv -f "$helper.$$" "$helper"
        else
          touch "$helper.failed"
        fi
        rm -f "$helper.$$"
        rm -rf "$helper.lock"
      ) < /dev/null > /dev/null 2>&1 &
      if [ -n "$NANOCODE_BUILDCACHE_URL" ] || [ "$1" = publish ]; then
        wait $!
        [ -x "$helper" ] && exec "$helper" "$scripts" "$@"
      fi
    fi
    ;;
esac
run "$@"
