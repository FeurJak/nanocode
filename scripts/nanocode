#!/bin/sh
case $0 in
  */*) scripts=${0%/*} ;;
  *) scripts=$(command -v -- "$0") && scripts=${scripts%/*} || exit 1 ;;
esac
root=$scripts/..
store=${XDG_CACHE_HOME:-$HOME/.cache}/nanocode/launch
helper=$store/launch
stamp=$("$helper" find "$scripts/launch.rs" "$root" "$store" 2> /dev/null)
case $? in
  0) exec "$stamp" "$@" ;;
  1) ;;
  *)
    stamp=
    if command -v rustc > /dev/null && mkdir -p "$store"; then
      (rustc --edition 2024 -C opt-level=2 -C strip=symbols -o "$helper.$$" "$scripts/launch.rs" && mv -f "$helper.$$" "$helper"; rm -f "$helper.$$") < /dev/null > /dev/null 2>&1 &
    fi
    ;;
esac
if [ -n "$stamp" ]; then
  binary=$(cd "$root" && cargo build --locked --release -p nanocode-cli --message-format=json-render-diagnostics | "$helper" built . "$store" "$stamp") || exit
else
  built=$(cd "$root" && cargo build --locked --release -p nanocode-cli --message-format=json-render-diagnostics) || exit
  binary=$(printf '%s\n' "$built" | sed -n 's/.*"executable":"\([^"]*\/nanocode\)".*/\1/p' | tail -n 1)
  [ -x "$binary" ] && [ -x "$binary-exec" ] || {
    echo "scripts/nanocode: cargo reported no nanocode and nanocode-exec binaries" >&2
    exit 1
  }
fi
exec "$binary" "$@"
