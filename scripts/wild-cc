#!/bin/sh
dir=${XDG_CACHE_HOME:-$HOME/.cache}/nanocode/wild
wild=$(command -v wild) || exec cc "$@"
if [ "$(readlink "$dir/ld")" != "$wild" ]; then
  mkdir -p "$dir" && ln -sfn "$wild" "$dir/ld.$$" && mv -f "$dir/ld.$$" "$dir/ld" || exec cc "$@"
fi
for arg; do
  shift
  [ "$arg" = -fuse-ld=lld ] || set -- "$@" "$arg"
done
exec cc -B"$dir" "$@"
