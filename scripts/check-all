#!/usr/bin/env bash
# scripts/check-all [--full] [DIR...]: runs scripts/check here and in every DIR (another clone with
# its own scripts/check) at the same time, then prints each repository's lines in order and one
# GREEN or RED line for all of them. --full is passed to every scripts/check.
set -uo pipefail
here=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
args=() dirs=("$here")
for arg; do
  case $arg in
    --*) args+=("$arg") ;;
    *) dirs+=("$(cd "$arg" && pwd)") || exit 2 ;;
  esac
done
if [ -t 1 ]; then green=$'\e[32m' red=$'\e[31m' off=$'\e[0m'; else green="" red="" off=""; fi
out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
start=$(date +%s)
pids=()
for i in "${!dirs[@]}"; do
  d=${dirs[$i]}
  if [ -x "$d/scripts/check" ]; then
    "$d/scripts/check" "${args[@]}" >"$out/$i" 2>&1 </dev/null &
    pids+=($!)
  else
    echo "FAIL no scripts/check in $d" >"$out/$i"
    pids+=(0)
  fi
done
failed=0
for i in "${!dirs[@]}"; do
  rc=1
  [ "${pids[$i]}" != 0 ] && { wait "${pids[$i]}"; rc=$?; }
  echo "== ${dirs[$i]}"
  cat "$out/$i"
  [ $rc = 0 ] || failed=1
done
if [ $failed = 0 ]; then echo "${green}ALL GREEN${off} $(( $(date +%s) - start ))s"; else echo "${red}RED${off} $(( $(date +%s) - start ))s"; fi
exit $failed

