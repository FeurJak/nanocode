#!/bin/sh
set -eu
command -v zstd > /dev/null && packs=buildcache || packs=buildcache-gz
release=${NANOCODE_BUILDCACHE_RELEASE:-https://api.github.com/repos/nanocodexyz/nanocode/releases/tags/$packs}
dir=${XDG_CACHE_HOME:-$HOME/.cache}/nanocode/remote
rm -rf "$dir.next"
mkdir -p "$dir.next/units" "$dir.next/workspace"
base=$(printf %s "$release" | sed -n 's,^https://api.github.com/repos/\([^/]*/[^/]*\)/releases/tags/\([^/]*\)$,https://github.com/\1/releases/download/\2,p')
helper=helper-$(cksum < "${0%/*}/buildcache.rs" | cut -d' ' -f1)-$(uname -sm | tr ' ' -)
if [ -n "$base" ]; then
  curl -sfL -Z -o "$dir.next/eager" "$base/workspace-eager" -o "$dir.next/index" "$base/workspace-index" -o "$dir.next/helper" "$base/workspace-$helper" || true
fi
if [ -s "$dir.next/eager" ] && [ -s "$dir.next/index" ]; then
  echo "$base/{dir}-{key}" > "$dir.next/url"
  name=$(grep "^workspace-$helper-[0-9a-f]*$" "$dir.next/eager" || true)
  [ -s "$dir.next/helper" ] && [ -n "$name" ] && mv "$dir.next/helper" "$dir.next/workspace/${name#workspace-}"
  gzip -dc < "$dir.next/index" > "$dir.next/workspace/index" 2> /dev/null || zstd -dcq < "$dir.next/index" > "$dir.next/workspace/index"
  grep -E '^(units|workspace)-[0-9a-f]{64}$' "$dir.next/eager" > "$dir.next/pending" || rm -f "$dir.next/pending"
else
  curl -sfL "$release" | grep -o '"browser_download_url": *"[^"]*"' | sed 's/.*"\(http[^"]*\)"/\1/' | while read -r url; do
    name=${url##*/}
    printf 'url = "%s"\noutput = "%s/%s/%s"\n' "$url" "$dir.next" "${name%%-*}" "${name#*-}"
  done > "$dir.next/config"
  curl -sfL -Z -K "$dir.next/config"
fi
rm -f "$dir.next/config" "$dir.next/eager" "$dir.next/index" "$dir.next/helper"
rm -rf "$dir"
mv "$dir.next" "$dir"
echo "file://$dir/{dir}/{key}"
