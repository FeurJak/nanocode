#!/usr/bin/env bash
# scripts/check: the checks below, one green/red line each with its time, then GREEN or RED.
#   scripts/check          changed scope: the crates the diff touches plus their dependents
#                          (cargo check, native and wasm32), and the simulator scenarios that
#                          reach those crates: their pass jobs and every canary they list
#   scripts/check --full   release gate: the whole workspace and every scenario and canary
# Options: --base REF (diff base; default: merge-base with the upstream, or HEAD~1 when nothing
#   differs), -j N (parallel jobs; default: all cores), --seeds N (seeds per pass job; default 8,
#   64 with --full), --no-sim.
# Jobs come from bin/nanocode-sim/cfo.sh's table, with its flags; scenarios it doesn't list get a
# pass job and a --twice job. A canary passes once a seed catches it, trying seeds 0, then 1..8,
# then the rest of its budget (canary:N, default 400).
# Logs: output/check/<check>.log.
set -uo pipefail
root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cd "$root"
full=0 base="" jobs=$(nproc 2>/dev/null || sysctl -n hw.ncpu) seeds="" sim=1
while [ $# -gt 0 ]; do
  case $1 in
    --full) full=1 ;;
    --base) base=$2; shift ;;
    -j) jobs=$2; shift ;;
    --seeds) seeds=$2; shift ;;
    --no-sim) sim=0 ;;
    -h | --help) sed -n '2,13p' "$0"; exit 0 ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
  shift
done
[ -n "$seeds" ] || { [ $full = 1 ] && seeds=64 || seeds=8; }
export CARGO_BUILD_JOBS=$jobs SHIPPY_REMOTE_BUILD=0 CARGO_TERM_COLOR=never
target=${CARGO_TARGET_DIR:-$root/target}
logs=$root/output/check
rm -rf "$logs"; mkdir -p "$logs"
if [ -t 1 ]; then green=$'\e[32m' red=$'\e[31m' yellow=$'\e[33m' off=$'\e[0m'; else green="" red="" yellow="" off=""; fi
now() { python3 -c 'import time; print(time.time())'; }
secs() { python3 -c "print('%.1f' % ($(now) - $1))"; }
started=$(now)
line() { printf '%s%-4s%s %-10s %6ss  %s\n' "$1" "$2" "$off" "$3" "$4" "$5"; }
# run NAME DETAIL CMD...: runs CMD into output/check/NAME.log and prints one line.
run() {
  local name=$1 detail=$2 t0 rc
  shift 2
  t0=$(now)
  "$@" >"$logs/$name.log" 2>&1
  rc=$?
  if [ $rc -eq 0 ]; then
    line "$green" ok "$name" "$(secs $t0)" "$detail"
  else
    line "$red" FAIL "$name" "$(secs $t0)" "$detail (exit $rc, output/check/$name.log)"
    grep -E '^(error|FAIL|FAILJOB|MISSEDJOB)|panicked' "$logs/$name.log" | head -20 | sed 's/^/     /'
    tail -4 "$logs/$name.log" | sed 's/^/     | /'
    touch "$logs/$name.failed"
  fi
  return $rc
}
skip() { line "$yellow" skip "$1" "0.0" "$2"; }

# Scope. Line 1: "all" or the changed workspace library crates plus their dependents.
# Line 2: "all" or the simulator scenarios whose modules changed or whose crates (by the
# nanocode_* paths their modules name) are among the changed crates or their dependents.
scope_py=$(cat <<'PY'
import json, os, re, sys
m = json.load(sys.stdin)
root = m["workspace_root"] + "/"
members = set(m["workspace_members"])
pkgs = {p["id"]: p for p in m["packages"] if p["id"] in members}
dirs = [((os.path.dirname(p["manifest_path"]) + "/")[len(root):], p["name"]) for p in pkgs.values()]
changed = [c for c in os.environ["CHANGED"].split("\n") if c]
libs = {p["name"] for p in pkgs.values() if any(k in ("lib", "rlib") for t in p["targets"] for k in t["kind"])}
everything = ("Cargo.toml", "Cargo.lock", "rust-toolchain", "rust-toolchain.toml")
if os.environ["FULL"] == "1" or any(c in everything or c.startswith((".cargo/", "vendor/", "scripts/buildcache", "scripts/rustc-parallel-frontend", "scripts/wild-cc", "scripts/check")) for c in changed):
    print("all\nall"); sys.exit()
hit = set()
for c in changed:
    owners = [d for d in dirs if c.startswith(d[0])]
    if owners: hit.add(max(owners, key=lambda d: len(d[0]))[1])
names = {p["name"] for p in pkgs.values()}
rdeps = {}
for p in pkgs.values():
    for d in p["dependencies"]:
        if d.get("path") and d["name"] in names: rdeps.setdefault(d["name"], set()).add(p["name"])
todo = list(hit)
while todo:
    for r in rdeps.get(todo.pop(), ()):
        if r not in hit: hit.add(r); todo.append(r)
print(" ".join(sorted(hit & libs)))
src = "bin/nanocode-sim/src/"
sim_changed = [c for c in changed if c.startswith("bin/nanocode-sim/")]
if "nanocode-sim" not in hit:
    print(""); sys.exit()
mods = {}
for f in sorted(os.listdir(src)):
    if f.endswith(".rs"): mods.setdefault(f[:-3], []).append(src + f)
    elif os.path.isdir(src + f):
        for d, _, fs in os.walk(src + f):
            mods.setdefault(f, []).extend(os.path.join(d, x) for x in fs if x.endswith(".rs"))
text = {k: "\n".join(open(f).read() for f in v) for k, v in mods.items()}
crate_of = {name.replace("-", "_"): name for name in libs}
uses = {k: {crate_of[c] for c in re.findall(r"\b(nanocode_\w+)", t) if c in crate_of} for k, t in text.items()}
refs = {k: {r for r in re.findall(r"\b(\w+)::", t) if r in mods and r != k and r != "main"} for k, t in text.items()}
names = re.search(r"--scenario ([a-z_|]+)\]", text["main"]).group(1).split("|")
special = {"runtime": "whole", "executor": "tasks"}
picked = []
for s in names:
    entry = next((e for e in (s.replace("_", ""), s, special.get(s)) if e in mods), None)
    if entry is None: picked.append(s); continue
    seen, todo = {entry}, [entry]
    while todo:
        for r in refs[todo.pop()]:
            if r not in seen: seen.add(r); todo.append(r)
    files = {f for k in seen | {"main"} for f in mods[k]}
    crates = set().union(*(uses[k] for k in seen | {"main"}))
    # A sim file outside every module (new), or outside src (Cargo.toml, cfo.sh), reaches every scenario.
    if any(c in files or not any(c in v for v in mods.values()) for c in sim_changed) or crates & hit:
        picked.append(s)
print(" ".join(picked))
PY
)
if [ $full = 0 ] && [ -z "$base" ]; then
  upstream=$(git rev-parse -q --verify '@{upstream}' 2>/dev/null || git rev-parse -q --verify origin/master)
  base=$(git merge-base HEAD "$upstream" 2>/dev/null || echo HEAD)
  if [ "$(git rev-parse HEAD)" = "$(git rev-parse "$base")" ] && [ -z "$(git status --porcelain)" ]; then base=HEAD~1; fi
fi
changed=""
[ $full = 0 ] && changed=$( { git diff --name-only "$base" --; git ls-files --others --exclude-standard; } | sort -u)
scope=$(cargo metadata --format-version 1 --locked --no-deps 2>"$logs/metadata.log" | FULL=$full CHANGED="$changed" python3 -I -c "$scope_py") || {
  line "$red" FAIL scope 0.0 "cargo metadata or scope selection failed (output/check/metadata.log)"; tail -5 "$logs/metadata.log"; exit 1; }
crates=$(echo "$scope" | sed -n 1p) scenarios=$(echo "$scope" | sed -n 2p)
printf '%s\n' "$scope" >"$logs/scope.txt"
since=""; [ $full = 0 ] && since=" since $(git rev-parse --short "$base")"
if [ "$crates" = all ]; then sel=(--workspace); detail="workspace"
elif [ -n "$crates" ]; then sel=(); for p in $crates; do sel+=(-p "$p"); done; detail="$(echo $crates | wc -w | tr -d ' ') crates changed$since, with dependents"
else sel=(); detail="no crates changed$since"; fi
[ $sim = 1 ] && [ -n "$scenarios" ] || sim=0

# The release simulator builds in its own target dir, at the same time as the debug checks.
if [ $sim = 1 ]; then
  ( CARGO_TARGET_DIR=$target/check-sim cargo build --locked --release -p nanocode-sim >"$logs/sim-build.log" 2>&1; echo $? >"$logs/sim-build.rc" ) &
  sim_pid=$!
fi
if [ ${#sel[@]} -gt 0 ]; then
  run check "$detail" cargo check --locked --lib "${sel[@]}"
  run check-wasm "$detail" cargo check --locked --lib --target wasm32-unknown-unknown "${sel[@]}" ||
    { grep -q "__builtin_c[lt]zg" "$logs/check-wasm.log" && echo "     this clang can't build python-capi's wasm32 libc++: set NANOCODE_CC to the clang docs/RELEASE-CHAIN.md uses"; }
else
  skip check "$detail"; skip check-wasm "$detail"
fi

simrun() {
  local name=$1 kind=$2 to=$3; shift 3
  local out rc from=0 upto
  if [ "$kind" = pass ]; then
    out=$("$SIM_BIN" --seeds "0..$to" "$@" 2>&1); rc=$?
    if [ $rc = 0 ]; then echo "PASSJOB $name"; else echo "FAILJOB $name exit=$rc :: nanocode-sim --seeds 0..$to $*"; echo "$out" | grep -m3 '^FAIL\|panicked'; fi
    return
  fi
  for upto in 1 8 "$to"; do
    [ "$upto" -gt "$to" ] && upto=$to
    [ "$upto" -le "$from" ] && continue
    out=$("$SIM_BIN" --seeds "$from..$upto" "$@" 2>&1); rc=$?
    if [ $rc = 0 ] && echo "$out" | grep -q '^MUTATION .* caught by'; then echo "CAUGHTJOB $name seeds=$from..$upto"; return; fi
    from=$upto
  done
  echo "MISSEDJOB $name exit=$rc :: nanocode-sim --seeds 0..$to $*"
}
simall() {
  export -f simrun
  xargs -P "$jobs" -L 1 bash -c 'simrun "$@"' _ <"$logs/sim-jobs.txt" >"$logs/sim.out" 2>&1
  cat "$logs/sim.out"
  local p f c m
  p=$(grep -c '^PASSJOB' "$logs/sim.out"); f=$(grep -c '^FAILJOB' "$logs/sim.out")
  c=$(grep -c '^CAUGHTJOB' "$logs/sim.out"); m=$(grep -c '^MISSEDJOB' "$logs/sim.out")
  echo "SIM pass_jobs=$p failed_jobs=$f canaries_caught=$c missed=$m"
  [ "$f" = 0 ] && [ "$m" = 0 ] && [ $((p + c)) -gt 0 ]
}
if [ $sim = 1 ]; then
  t0=$(now); wait $sim_pid; rc=$(cat "$logs/sim-build.rc")
  export SIM_BIN=$target/check-sim/release/nanocode-sim
  if [ "$rc" = 0 ]; then
    line "$green" ok sim-build "$(secs $t0)" "release nanocode-sim (time left after the checks)"
    run tidy "nanocode-sim --tidy" "$SIM_BIN" --tidy
    table=$(awk "/^default_table='/{f=1;next} f&&/^'/{exit} f" bin/nanocode-sim/cfo.sh)
    [ "$scenarios" = all ] && scenarios=$("$SIM_BIN" 2>&1 | grep -o -- '--scenario [a-z_|]*' | head -1 | sed 's/--scenario //' | tr '|' ' ')
    for s in $scenarios; do
      echo "$table" | grep -q -- "--scenario $s\( \|$\)" || table="$table
8 $s pass --scenario $s
2 ${s}_twice pass --scenario $s --twice"
    done
    echo "$table" | SCENARIOS=" $scenarios " awk -v seeds="$seeds" 'NF >= 3 {
      s = ""; for (i = 4; i < NF; i++) if ($i == "--scenario") s = $(i + 1)
      if (index(ENVIRON["SCENARIOS"], " " s " ") == 0) next
      flags = ""; for (i = 4; i <= NF; i++) flags = flags " " $i
      if ($3 == "pass") print $2, "pass", seeds, flags
      else if ($3 ~ /^canary/) { n = 400; if ($3 ~ /^canary:/) { split($3, k, ":"); n = k[2] } print $2, "canary", n, flags }
    }' >"$logs/sim-jobs.txt"
    np=$(awk '$2=="pass"' "$logs/sim-jobs.txt" | wc -l | tr -d ' '); nc=$(awk '$2=="canary"' "$logs/sim-jobs.txt" | wc -l | tr -d ' ')
    run sim "$(echo $scenarios | wc -w | tr -d ' ') scenarios: $np pass jobs x $seeds seeds, $nc canaries" simall
  else
    line "$red" FAIL sim-build "$(secs $t0)" "(output/check/sim-build.log)"
    grep -E '^error' -A5 "$logs/sim-build.log" | head -20 | sed 's/^/     | /'
    touch "$logs/sim-build.failed"
  fi
else
  skip sim "no simulator scenario reaches the changed crates"
fi

if ls "$logs"/*.failed >/dev/null 2>&1; then
  printf '%sRED%s   nanocode %ss (%s)\n' "$red" "$off" "$(secs $started)" "$(cd "$logs" && ls *.failed | sed 's/.failed//' | tr '\n' ' ')"; exit 1
fi
printf '%sGREEN%s nanocode %ss\n' "$green" "$off" "$(secs $started)"

